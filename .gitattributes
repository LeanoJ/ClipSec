Dockerfile  text eol=lf
*.conf      text eol=lf

*.cs        text diff=csharp
*.xaml      text
*.csproj    text
*.sln       text eol=crlf
*.ps1       text eol=crlf

*.ico       binary
*.png       binary
*.jpg       binary
*.exe       binary
