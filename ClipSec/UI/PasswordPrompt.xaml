<Window x:Class="ClipSec.UI.PasswordPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipSec" Width="400" SizeToContent="Height"
        Style="{StaticResource WindowBase}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
        Icon="pack://application:,,,/ClipSec;component/Assets/clipsec.ico">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="MessageText" Margin="0,6,0,14" Style="{StaticResource Secondary}" />
        <PasswordBox x:Name="Box" KeyDown="Box_KeyDown" />
        <Button x:Name="KeyButton" Margin="0,8,0,0" Click="KeyButton_Click" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" Margin="0,2,8,0" />
                <TextBlock Text="Stattdessen Sicherheitsschlüssel verwenden" />
            </StackPanel>
        </Button>
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Style="{StaticResource Error}" Visibility="Collapsed" />
        <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Content="Bestätigen" Style="{StaticResource AccentButton}" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
