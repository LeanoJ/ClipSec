<Window x:Class="ClipSec.UI.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipSec installieren" Width="520" SizeToContent="Height"
        Style="{StaticResource WindowBase}"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/ClipSec;component/Assets/clipsec.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="28,24,28,20">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/ClipSec;component/Assets/clipsec.ico" Width="40" Height="40" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Text="ClipSec installieren" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource Secondary}" Margin="0,18,0,0"
                       Text="Wird nur für dein Benutzerkonto installiert – Administratorrechte sind nicht nötig. Deinstallieren geht später über „Einstellungen → Apps“." />
            <TextBlock Margin="0,14,0,4" Text="Installationsordner" />
            <TextBlock x:Name="PathText" Style="{StaticResource Secondary}" />

            <TextBlock Style="{StaticResource Heading}" Text="Optionen" />
            <CheckBox x:Name="DesktopCheck" Content="Verknüpfung auf dem Desktop" />
            <CheckBox x:Name="AutostartCheck" IsChecked="True" Content="Mit Windows starten (empfohlen)" />
            <CheckBox x:Name="LaunchCheck" IsChecked="True" Content="ClipSec nach der Installation starten" />

            <TextBlock x:Name="RunningHint" Style="{StaticResource Secondary}" Margin="0,12,0,0" Visibility="Collapsed"
                       Text="ClipSec läuft gerade und wird dafür kurz beendet." />
            <TextBlock x:Name="ErrorText" Style="{StaticResource Error}" Margin="0,12,0,0" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Padding="28,14">
            <Grid>
                <Button x:Name="PortableButton" HorizontalAlignment="Left" Style="{StaticResource LinkButton}"
                        VerticalAlignment="Center" Content="Ohne Installation starten" Click="Portable_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen" IsCancel="True" Margin="0,0,8,0" />
                    <Button x:Name="InstallButton" Content="Installieren" Style="{StaticResource AccentButton}"
                            IsDefault="True" Click="Install_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
