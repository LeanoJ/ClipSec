<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\clipsec.ico</ApplicationIcon>
    <AssemblyName>ClipSec</AssemblyName>
    <RootNamespace>ClipSec</RootNamespace>
    <Product>ClipSec</Product>
    <Description>Gesicherter Zwischenablage-Verlauf für Windows</Description>
    <Version>1.2.0</Version>
    <!-- WinForms-DPI-Hinweis betrifft nur WinForms-Apps; hier steuert das Manifest (PerMonitorV2) WPF. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms-Namespaces kollidieren mit WPF; nur NotifyIcon wird explizit genutzt -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\clipsec.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Screenshot-Werkzeug baut die echten Fenster mit Beispieldaten auf -->
    <InternalsVisibleTo Include="ClipSec.Screenshots" />
  </ItemGroup>

</Project>
